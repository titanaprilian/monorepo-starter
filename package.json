{
  "name": "monorepo-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.1.0"
  }
}
