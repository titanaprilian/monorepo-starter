{
  "name": "@repo/backend",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elysiajs/rate-limit": "npm:elysia-rate-limit@4.6.2",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@repo/config-vitest": "workspace:*",
    "bun-types": "latest",
    "eslint": "^10.8.0",
    "postgres": "^3.4.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.1.0"
  },
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  }
}
